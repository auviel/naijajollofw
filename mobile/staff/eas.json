{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false, "image": "latest" },
      "android": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" },
      "android": { "image": "latest" },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "distribution": "internal",
      "ios": { "image": "latest" },
      "android": { "image": "latest" },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
