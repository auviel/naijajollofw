{
  "expo": {
    "name": "Naija Jollof",
    "slug": "naija-jollof-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "naijajollof",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.naijajollofw.diner",
      "infoPlist": {
        "CFBundleDisplayName": "Naija Jollof",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.naijajollofw.diner",
      "label": "Naija Jollof",
      "adaptiveIcon": {
        "backgroundColor": "#CC5400",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#CC5400",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-square-in-app-payments",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "naija-jollof-waterloo",
          "project": "naijajollofw-diner"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3f9aa04f-fece-419d-bc26-f16cc71705fd"
      },
      "router": {}
    },
    "owner": "auviel"
  }
}
