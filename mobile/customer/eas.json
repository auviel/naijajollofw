{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false, "image": "latest" },
      "android": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "image": "latest" },
      "android": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://new.naijajollofw.ca"
      }
    },
    "production": {
      "distribution": "store",
      "ios": { "image": "latest" },
      "android": { "image": "latest" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://new.naijajollofw.ca"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
