{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naijajollofw-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    // Do not use CLOUDFLARE_ENV here — Wrangler reserves that name for `--env` selection.
    "APP_ENV": "production",
  },
  "observability": {
    // Keep observability on, but sample aggressively — 100% logs burns quota
    // and noise (esp. /monitoring Sentry tunnel) without helping a small site.
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 0.1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "naijajollofw-web",
    },
  ],
  // App data is on Railway Postgres. Hyperdrive origin = Railway TCP proxy
  // (DATABASE_PUBLIC_URL / caboose.proxy.rlwy.net). Hyperdrive is the pooler.
  // Update with: npx wrangler hyperdrive update <id> --connection-string="$RAILWAY_PUBLIC_URL"
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "bad82ca6b68444b4be502e1e67b40572",
      "localConnectionString": "postgresql://delivergo:delivergo@localhost:5433/delivergo?schema=public",
    },
  ],
  // Next.js ISR / data cache only — not menu images (those stay on the media bucket).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "naijajollofw-next-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],
  // OpenNext on-demand revalidateTag store. This is NOT the restaurant database.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "naijajollofw-next-tag-cache",
      "database_id": "fd4cb1c3-d52d-4fda-9004-5427c3a975b5",
    },
  ],
}
