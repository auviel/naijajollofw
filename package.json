{
  "name": "delivergo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "npm run typecheck --prefix mobile/customer && npm run typecheck --prefix mobile/staff",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit": "npm audit --audit-level=high",
    "db:validate": "prisma validate",
    "prepush": "npm run lint && npm run typecheck && npm run db:validate && npm run test:coverage && npm run audit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "doordash:register-store": "tsx scripts/register-doordash-store.ts",
    "doordash:list-stores": "tsx scripts/list-doordash-stores.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0 --fix"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.51",
    "@ai-sdk/react": "^4.0.87",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@opennextjs/cloudflare": "^1.20.2",
    "@portabletext/react": "^8.0.1",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.65.0",
    "ai": "^7.0.84",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^13.3.3",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.2",
    "square": "^44.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^10",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@auth/core": ">=0.41.3",
    "nanoid": ">=3.3.18",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.1.1",
    "esbuild": ">=0.28.1",
    "smol-toml": ">=1.6.1",
    "uuid": ">=11.1.1"
  }
}
